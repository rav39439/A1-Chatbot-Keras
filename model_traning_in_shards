if not SHARDS_EXIST:

    print("\nCounting tokens chunk by chunk...")
    
    total_tokens = 0
    
    for text_chunk in iter_text_chunks(DATA_FILE):
    
        chunk_ids = tokenize_chunk(text_chunk)
    
        total_tokens += len(chunk_ids)
    
        del chunk_ids
    
    print("Total tokens:", total_tokens)
    
    if total_tokens < 2 * SEQ_LEN:
        raise ValueError(
            "The corpus is too small for the selected sequence length "
            "and train/validation split."
        )
    
    
    # =========================================================
    # 5. TRAIN / VALIDATION SPLIT
    # =========================================================
    
    split_index = int(
        total_tokens * TRAIN_RATIO
    )
    
    train_token_count = split_index
    val_token_count = total_tokens - split_index
    
    print("\nToken split:")
    print("Training tokens:", train_token_count)
    print("Validation tokens:", val_token_count)
    
    # These match the original create_windows() behavior:
    # each split starts its own sequence-window stride.
    
    train_window_count = max(
        0,
        (train_token_count - SEQ_LEN) // STRIDE + 1
    )
    
    val_window_count = max(
        0,
        (val_token_count - SEQ_LEN) // STRIDE + 1
    )
    
    if train_window_count == 0 or val_window_count == 0:
        raise ValueError(
            "Training or validation contains no complete windows. "
            "Check SEQ_LEN, STRIDE, and TRAIN_RATIO."
        )
    
    print("Training windows expected:", train_window_count)
    print("Validation windows expected:", val_window_count)
    


    train_writer = ShardWriter("train")
    val_writer = ShardWriter("val")
    
    token_buffer = []
    
    # Global token index corresponding to token_buffer[0].
    buffer_start = 0
    
    next_train_start = 0
    next_val_start = split_index
    
    try:
    
        for text_chunk in iter_text_chunks(DATA_FILE):
    
            chunk_ids = tokenize_chunk(text_chunk)
    
            token_buffer.extend(chunk_ids)
    
            del chunk_ids
    
            buffer_end = (
                buffer_start + len(token_buffer)
            )
    
            # -------------------------------------------------
            # Write training windows
            # -------------------------------------------------
    
            while (
                next_train_start + SEQ_LEN <= split_index
                and next_train_start + SEQ_LEN <= buffer_end
            ):
    
                local_start = (
                    next_train_start - buffer_start
                )
    
                window = token_buffer[
                    local_start:local_start + SEQ_LEN
                ]
    
                train_writer.write(window)
    
                next_train_start += STRIDE
    
            # -------------------------------------------------
            # Write validation windows
            # -------------------------------------------------
    
            while (
                next_val_start + SEQ_LEN <= total_tokens
                and next_val_start + SEQ_LEN <= buffer_end
            ):
    
                local_start = (
                    next_val_start - buffer_start
                )
    
                window = token_buffer[
                    local_start:local_start + SEQ_LEN
                ]
    
                val_writer.write(window)
    
                next_val_start += STRIDE
    
            # -------------------------------------------------
            # Discard tokens no longer needed
            # -------------------------------------------------
    
            earliest_needed = min(
                next_train_start
                if next_train_start + SEQ_LEN <= split_index
                else split_index,
                next_val_start
            )
    
            discard_count = max(
                0,
                min(
                    earliest_needed - buffer_start,
                    len(token_buffer)
                )
            )
    
            if discard_count > 0:
    
                del token_buffer[:discard_count]
    
                buffer_start += discard_count
    
    finally:
    
        train_writer.close()
        val_writer.close()
    
    
    print("\nStreaming preprocessing completed.")
    
    print(
        "Training windows written:",
        train_writer.total_windows
    )
    
    print(
        "Validation windows written:",
        val_writer.total_windows
    )
    
    assert train_writer.total_windows == train_window_count, (
        "Training window count mismatch."
    )
    
    assert val_writer.total_windows == val_window_count, (
        "Validation window count mismatch."
    )


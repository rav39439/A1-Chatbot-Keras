def iter_text_chunks(
    file_path,
    chunk_size=CHAR_CHUNK_SIZE
):
    """
    Read text incrementally while preserving word boundaries
    between consecutive chunks.
    """

    with open(file_path, "r", encoding="utf-8") as f:

        pending = ""

        while True:

            raw = f.read(chunk_size)

            if not raw:
                break

            pending += raw

            # Keep the final incomplete word for the next read.
            cut = max(
                pending.rfind(" "),
                pending.rfind("\n"),
                pending.rfind("\t"),
                pending.rfind("\r")
            )

            if cut < 0:
                continue

            chunk = pending[:cut + 1]
            pending = pending[cut + 1:]

            if chunk:
                yield chunk

        if pending:
            yield pending


def tokenize_chunk(text_chunk):

    result = tokenizer(
        text_chunk,
        add_special_tokens=False,
        return_attention_mask=False,
        return_token_type_ids=False,
        truncation=False
    )

    return result["input_ids"]


class ShardWriter:

    def __init__(
        self,
        prefix,
        shard_dir=SHARD_DIR,
        windows_per_shard=WINDOWS_PER_SHARD
    ):

        self.prefix = prefix
        self.shard_dir = shard_dir
        self.windows_per_shard = windows_per_shard

        self.shard_index = -1
        self.windows_in_shard = 0
        self.total_windows = 0
        self.writer = None

    def _open_next_shard(self):

        if self.writer is not None:
            self.writer.close()

        self.shard_index += 1
        self.windows_in_shard = 0

        path = os.path.join(
            self.shard_dir,
            f"{self.prefix}-{self.shard_index:05d}.tfrecord"
        )

        self.writer = tf.io.TFRecordWriter(path)

        print("Writing shard:", path)

    def write(self, window):

        if (
            self.writer is None
            or self.windows_in_shard >= self.windows_per_shard
        ):
            self._open_next_shard()

        feature = {
            "token_ids": tf.train.Feature(
                int64_list=tf.train.Int64List(
                    value=[int(token) for token in window]
                )
            )
        }

        example = tf.train.Example(
            features=tf.train.Features(
                feature=feature
            )
        )

        self.writer.write(
            example.SerializeToString()
        )

        self.windows_in_shard += 1
        self.total_windows += 1

    def close(self):

        if self.writer is not None:
            self.writer.close()
            self.writer = None

def parse_tfrecord(record):

    feature_description = {
        "token_ids": tf.io.FixedLenFeature(
            [SEQ_LEN],
            tf.int64
        )
    }

    parsed = tf.io.parse_single_example(
        record,
        feature_description
    )

    token_ids = tf.cast(
        parsed["token_ids"],
        tf.int32
    )

    inputs = token_ids[:-1]
    targets = token_ids[1:]

    return inputs, targets

        verbose=1
    )

    early_stopping = EarlyStopping(
        monitor="val_loss",
        mode="min",
        patience=12,
        restore_best_weights=True,
        verbose=1
    )

    reduce_lr = ReduceLROnPlateau(
        monitor="val_loss",
        mode="min",
        factor=0.5,
        patience=5,
        min_lr=1e-6,
        verbose=1
    )

    # ========================================================
    # 12. Train
    # ========================================================

    history = model.fit(
        X_train,
        y_train,
        validation_data=(
            X_val,
            y_val
        ),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,

        # Important for time-series
        shuffle=False,

        callbacks=[
            checkpoint,
            early_stopping,
            reduce_lr,
        ],

        verbose=1
    )

    # ========================================================
    # 13. Save metadata
    # ========================================================

    metadata = {

        "feature_schema_file":
            FEATURE_SCHEMA_FILE,

        "target_column":
            target_column,

        "input_features":
            input_features,

        "input_feature_count":
            len(input_features),

        "window_size":
            WINDOW_SIZE,

        "timestamp_columns":
            schema_info[
                "timestamp_columns"
            ],

        "identifier_columns":
            schema_info[
                "identifier_columns"
            ],

        "model_input_shape":
            [
                WINDOW_SIZE,
                len(input_features)
            ],

        "model_output_shape":
            [1],
    }

    with open(
        METADATA_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            metadata,
            f,
            indent=4
        )

    # ========================================================
    # 14. Validation prediction
    # ========================================================

    predictions = model.predict(
        X_val,
        batch_size=BATCH_SIZE,
        verbose=0
    ).reshape(-1)

    predictions = np.clip(
        predictions,
        0.0,
        1.0
    )

    mae = mean_absolute_error(
        y_val,
        predictions
    )

    rmse = np.sqrt(
        mean_squared_error(
            y_val,
            predictions
        )
    )

    print(
        "\n"
        + "=" * 70
    )

    print(
        "VALIDATION RESULTS"
    )

    print(
        "=" * 70
    )

    print(
        f"MAE  : {mae:.6f}"
    )

    print(
        f"RMSE : {rmse:.6f}"
    )

    print(
        "\nSample:"
    )

    result = pd.DataFrame(
        {
            "actual_failure_probability":
                y_val[:20],

            "predicted_failure_probability":
                predictions[:20]
        }
    )

    print(
        result.to_string(
            index=False
        )
    )

    print(
        "\nTraining completed."
    )

    print(
        f"Model  : {MODEL_FILE}"
    )

    print(
        f"Scaler : {SCALER_FILE}"
    )

    print(
        f"Metadata: {METADATA_FILE}"
    )

    return (
        model,
        scaler,
        history
    )



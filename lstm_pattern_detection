def encode_column(
    series,
    # encoding_registry
):

    result = []

    column_name = (
        str(series.name)
        .strip()
        .lower()
    )

    # --------------------------------------------------------
    # Binary / status columns
    # --------------------------------------------------------

    binary_columns = {
        "prefailed",
        "replace",
        "zero"
    }

    # --------------------------------------------------------
    # Status mapping
    #
    # 1.0 = Critical-low
    # 2.0 = Low / warning-low
    # 3.0 = Positive / healthy / normal
    # 4.0 = Negative / abnormal / warning / fault
    # 5.0 = Critical / failed / severe
    #
    # np.nan = Explicitly missing / unknown information
    #
    # 999.0 = Unsupported / unrecognized value
    # --------------------------------------------------------

    status_mapping = {
        
        #-----------nodes----------
        "mt-apollo-1a":1.0,
        "mt-apollo-1b":2.0,

        # ====================================================
        # Workload / activity categories
        # ====================================================
        
        

        "stable": 3.0,
        "idle": 3.0,

        "low": 2.0,
        "high": 4.0,

        "very_high": 5.0,
        "veryhigh": 5.0,


        # ====================================================
        # Normal / healthy states
        # ====================================================

        "normal": 3.0,
        "ok": 3.0,
        "good": 3.0,
        "healthy": 3.0,

        "ipmi_hb_ok": 3.0,

        "ok-with-suppressed": 3.0,


        # ====================================================
        # Positive states
        # ====================================================

        "true": 3.0,
        "yes": 3.0,
        "y": 3.0,
        "on": 3.0,

        "present": 3.0,
        "enabled": 3.0,
        "available": 3.0,


        # ====================================================
        # Negative / abnormal states
        # ====================================================

        "false": 4.0,
        "no": 4.0,
        "n": 4.0,
        "off": 4.0,

        "absent": 4.0,
        "not_present": 4.0,
        "disabled": 4.0,
        "unavailable": 4.0,


        # ====================================================
        # ONTAP system health
        # ====================================================

        "degraded": 4.0,
        "unreachable": 4.0,
        "warning":4.0,


        # ====================================================
        # ONTAP environment sensor states
        # ====================================================

        "fault": 4.0,

        "init-failed": 4.0,

        "failed": 5.0,


        # ====================================================
        # ONTAP hardware / sensor states
        # ====================================================

        "bad": 4.0,

        "psu_fault": 4.0,

        "multifault": 5.0,


        # ====================================================
        # Low warning states
        # ====================================================

        "warn-low": 2.0,
        "warning-low": 2.0,
        "low-warning": 2.0,


        # ====================================================
        # Critical low states
        # ====================================================

        "crit-low": 1.0,
        "critical-low": 1.0,
        "low-critical": 1.0,


        # ====================================================
        # High warning states
        # ====================================================

        "warn-high": 4.0,
        "warning-high": 4.0,
        "high-warning": 4.0,
        "warn-hi": 4.0,


        # ====================================================
        # Critical high states
        # ====================================================

        "crit-high": 5.0,
        "critical-high": 5.0,
        "high-critical": 5.0,
        "critical-hi": 5.0,
        "crit-hi": 5.0,


        # ====================================================
        # Failure states
        # ====================================================

        "failure": 5.0,
        "fail": 5.0,
        "critical": 5.0,


        # ====================================================
        # Explicit missing / unknown information
        #
        # These are different from unsupported values.
        # ====================================================

        "unknown": np.nan,
        "not-available": np.nan,
        "n/a": np.nan,
        "na": np.nan,
        "none": np.nan,
        "null": np.nan,
        "nan": np.nan,
        "": np.nan,
    }


    # --------------------------------------------------------
    # Process each value
    # --------------------------------------------------------

    for value in series:
        

        # ====================================================
        # Actual Python / NumPy boolean
        # ====================================================

        if isinstance(
            value,
            (bool, np.bool_)
        ):

            result.append(
                3.0 if bool(value)
                else 4.0
            )

            continue


        # ====================================================
        # Missing value
        # ====================================================

        # if pd.isna(value):

        #     result.append(
        #         np.nan
        #     )

        #     continue


        # ====================================================
        # Normalize string
        # ====================================================

        cleaned = (
            str(value)
            .strip()
            .lower()
        )


        # ====================================================
        # Empty / missing string
        # ====================================================

        if cleaned == "":

            result.append(
                np.nan
            )

            continue


        # ====================================================
        # Known status / category
        #
        # Check this BEFORE numeric conversion.
        # ====================================================

        if cleaned in status_mapping:

            result.append(
                status_mapping[cleaned]
            )

            continue


        # ====================================================
        # Binary columns
        #
        # Only these specific columns use binary semantics.
        # ====================================================

        if column_name in binary_columns:

            # -----------------------------------------------
            # Positive binary state
            # -----------------------------------------------

            if cleaned in {
                "1",
                "1.0",
                "true",
                "yes",
                "y",
                "on",
                "present",
                "enabled",
                "available"
            }:

                result.append(
                    3.0
                )

                continue


            # -----------------------------------------------
            # Negative binary state
            # -----------------------------------------------

            if cleaned in {
                "0",
                "0.0",
                "false",
                "no",
                "n",
                "off",
                "absent",
                "not_present",
                "disabled",
                "unavailable"
            }:

                result.append(
                    4.0
                )

                continue


        # ====================================================
        # Numeric values
        #
        # Real numerical measurements remain unchanged.
        #
        # Examples:
        # latency
        # busy
        # read_iops
        # write_iops
        # temperature
        # power_on_hours
        # ====================================================

        try:

            numeric_value = float(
                cleaned
            )

            if np.isnan(numeric_value):

                result.append(
                    np.nan
                )

            else:

                result.append(
                    numeric_value
                )

            continue

        except (
            ValueError,
            TypeError
        ):

            pass

        result.append(
            999.0
        )


    # --------------------------------------------------------
    # Return encoded series
    # --------------------------------------------------------

    return pd.Series(
        result,
        index=series.index,
        dtype="float32"
    )


# ============================================================
# COLUMN NORMALIZATION

def validate_training_file(
    df,
    schema_info
):

    input_features = schema_info[
        "input_features"
    ]

    target_column = schema_info[
        "target_column"
    ]

    timestamp_columns = schema_info[
        "timestamp_columns"
    ]

    identifier_columns = schema_info[
        "identifier_columns"
    ]

    # --------------------------------------------------------
    # Required model columns
    # --------------------------------------------------------

    required_columns = (
        input_features
        + [target_column]
    )

    # --------------------------------------------------------
    # Optional columns
    # --------------------------------------------------------

    optional_columns = (
        timestamp_columns
        + identifier_columns
    )

    all_schema_columns = (
        required_columns
        + optional_columns
    )

    resolved, missing = (
        map_schema_columns_to_dataframe(
            df,
            all_schema_columns
        )
    )

    # --------------------------------------------------------
    # Missing required columns
    # --------------------------------------------------------

    missing_required = [
        column
        for column in missing
        if column in required_columns
    ]

    if missing_required:

        print(
            "\nMissing required columns:"
        )

        for column in missing_required:

            print(
                f"  - {column}"
            )

        raise ValueError(
            "Training file does not contain "
            "all required schema features."
        )

    # --------------------------------------------------------
    # Information
    # --------------------------------------------------------

    print(
        "\n"
        + "=" * 70
    )

    print(
        "TRAINING FILE VALIDATION"
    )

    print(
        "=" * 70
    )

    print(
        f"Total columns in file : "
        f"{len(df.columns)}"
    )

    print(
        f"Required model inputs : "
        f"{len(input_features)}"
    )

    print(
        f"Target                : "
        f"{target_column}"
    )

    # --------------------------------------------------------
    # Extra columns are intentionally ignored
    # --------------------------------------------------------

    schema_normalized = {
        normalize_column_name(x)
        for x in all_schema_columns
    }

    extra_columns = [
        column
        for column in df.columns
        if normalize_column_name(column)
        not in schema_normalized
    ]

    print(
        f"Extra columns ignored  : "
        f"{len(extra_columns)}"
    )

    if extra_columns:

        print(
            "\nExtra columns:"
        )

        for column in extra_columns:

            print(
                f"  - {column}"
            )

    return resolved


# ============================================================
# PREPARE DATAFRAME USING SCHEMA
# ============================================================

def prepare_training_dataframe(
    df,
    schema_info
):

    input_features = schema_info[
        "input_features"
    ]

    target_column = schema_info[
        "target_column"
    ]

    timestamp_columns = schema_info[
        "timestamp_columns"
    ]

    identifier_columns = schema_info[
        "identifier_columns"
    ]

    resolved, _ = (
        map_schema_columns_to_dataframe(
            df,
            input_features
            + [target_column]
            + timestamp_columns
            + identifier_columns
        )
    )

    # ========================================================
    # Create a clean internal dataframe
    #
    # Keys are schema names.
    # ========================================================

    clean = pd.DataFrame(
        index=df.index
    )

    # --------------------------------------------------------
    # Input features
    # --------------------------------------------------------

    for feature in input_features:

        actual_column = resolved[
            feature
        ]

        clean[feature] = pd.to_numeric(
            df[actual_column],
            errors="coerce"
        )

    # --------------------------------------------------------
    # Target
    # --------------------------------------------------------

    actual_target = resolved[
        target_column
    ]

    clean[target_column] = pd.to_numeric(
        df[actual_target],
        errors="coerce"
    )

    # --------------------------------------------------------
    # Timestamp
    # --------------------------------------------------------

    for timestamp in timestamp_columns:

        if timestamp in resolved:

            actual_column = resolved[
                timestamp
            ]

            clean[timestamp] = pd.to_datetime(
                df[actual_column],
                errors="coerce"
            )

    # --------------------------------------------------------
    # Identifier
    # --------------------------------------------------------

    for identifier in identifier_columns:

        if identifier in resolved:

            actual_column = resolved[
                identifier
            ]

            clean[identifier] = (
                df[actual_column]
                .astype(str)
                .str.strip()
            )

    return clean


# ============================================================
# CLEAN DATA
# ============================================================

def clean_training_data(
    df,
    schema_info
):

    input_features = schema_info[
        "input_features"
    ]

    target_column = schema_info[
        "target_column"
    ]

    timestamp_columns = schema_info[
        "timestamp_columns"
    ]

    identifier_columns = schema_info[
        "identifier_columns"
    ]

    # ========================================================
    # Target validation
    # ========================================================

    invalid_target = (
        df[target_column].isna()
        |
        (df[target_column] < 0)
        |
        (df[target_column] > 1)
    )

    invalid_count = int(
        invalid_target.sum()
    )

    if invalid_count:

        print(
            f"\nRemoving {invalid_count} rows "
            "with invalid failure_probability."
        )

        df = df.loc[
            ~invalid_target
        ].copy()

    # ========================================================
    # Sort chronologically
    # ========================================================

    sort_columns = []

    if identifier_columns:

        identifier = identifier_columns[0]

        if identifier in df.columns:

            sort_columns.append(
                identifier
            )

    if timestamp_columns:

        timestamp = timestamp_columns[0]

        if timestamp in df.columns:

            sort_columns.append(
                timestamp
            )

    if sort_columns:

        df = df.sort_values(
            sort_columns
        )

    # ========================================================
    # Fill missing feature values PER DISK
    # ========================================================

    if identifier_columns:

        identifier = identifier_columns[0]

        if identifier in df.columns:

            df[input_features] = (
                df.groupby(
                    identifier,
                    sort=False
                )[input_features]
                .transform(
                    lambda x:
                    x.ffill().bfill()
                )
            )

    else:

        df[input_features] = (
            df[input_features]
            .ffill()
            .bfill()
        )

    # ========================================================
    # Remove rows still containing missing features
    # ========================================================

    before = len(df)

    df = df.dropna(
        subset=input_features
    )

    removed = (
        before - len(df)
    )

    if removed:

        print(
            f"Removed {removed} rows with "
            "invalid input features."
        )

    df = df.reset_index(
        drop=True
    )

    return df


# ============================================================
# SPLIT EACH DISK CHRONOLOGICALLY
# ============================================================

def split_by_disk_history(
    df,
    schema_info,
    validation_ratio=0.20
):

    identifier_columns = schema_info[
        "identifier_columns"
    ]

    timestamp_columns = schema_info[
        "timestamp_columns"
    ]

    train_parts = []
    val_parts = []

    # ========================================================
    # Disk identifier available
    # ========================================================

    if identifier_columns:

        identifier = identifier_columns[0]

        if identifier in df.columns:

            for disk_name, group in df.groupby(
                identifier,
                sort=False
            ):

                group = group.copy()

                if timestamp_columns:

                    timestamp = (
                        timestamp_columns[0]
                    )

                    if timestamp in group.columns:

                        group = group.sort_values(
                            timestamp
                        )

                if len(group) < 2:

                    continue

                split_index = int(
                    len(group)
                    * (1.0 - validation_ratio)
                )

                split_index = max(
                    1,
                    min(
                        split_index,
                        len(group) - 1
                    )
                )

                train_parts.append(
                    group.iloc[
                        :split_index
                    ]
                )

                val_parts.append(
                    group.iloc[
                        split_index:
                    ]
                )

    # ========================================================
    # No disk identifier
    # ========================================================

    else:

        group = df.copy()

        if timestamp_columns:

            timestamp = (
                timestamp_columns[0]
            )

            if timestamp in group.columns:

                group = group.sort_values(
                    timestamp
                )

        split_index = int(
            len(group)
            * (1.0 - validation_ratio)
        )

        train_parts.append(
            group.iloc[
                :split_index
            ]
        )

        val_parts.append(
            group.iloc[
                split_index:
            ]
        )

    # ========================================================
    # Verify
    # ========================================================

    if not train_parts:

        raise ValueError(
            "Could not create training split."
        )

    train_df = pd.concat(
        train_parts,
        ignore_index=True
    )

    val_df = pd.concat(
        val_parts,
        ignore_index=True
    )

    return (
        train_df,
        val_df
    )


# ============================================================
# SCALER
# ============================================================

def fit_scaler(
    train_df,
    input_features
):

    scaler = MinMaxScaler()

    scaler.fit(
        train_df[input_features]
    )

    return scaler



# ============================================================
# CREATE SUPERVISED LSTM WINDOWS
# ============================================================

def create_windows(
    df,
    schema_info,
    scaler,
    window_size
):

    input_features = schema_info[
        "input_features"
    ]

    target_column = schema_info[
        "target_column"
    ]

    timestamp_columns = schema_info[
        "timestamp_columns"
    ]

    X = []
    y = []

    # ========================================================
    # IMPORTANT:
    #
    # Do NOT group by disk_name here.
    #
    # The dataframe is treated as ONE continuous
    # time-series sequence.
    #
    # Window creation is based ONLY on row position.
    # ========================================================

    df = df.copy()

    # --------------------------------------------------------
    # Sort by timestamp
    # --------------------------------------------------------

    if timestamp_columns:

        timestamp = timestamp_columns[0]

        if timestamp in df.columns:

            df = df.sort_values(
                timestamp
            )

    # --------------------------------------------------------
    # Reset row numbers after sorting
    # --------------------------------------------------------

    df = df.reset_index(
        drop=True
    )

    # ========================================================
    # Check whether enough rows exist
    # ========================================================

    if len(df) < window_size:

        raise ValueError(
            f"Not enough rows to create windows.\n"
            f"Rows available : {len(df)}\n"
            f"Window size    : {window_size}"
        )

    # ========================================================
    # Get input features
    #
    # Only schema-defined LSTM features are used.
    # disk_name, timestamp and target are NOT inputs.
    # ========================================================

    feature_values = scaler.transform(
        df[input_features]
    ).astype(
        np.float32
    )

    # ========================================================
    # Get target values
    # ========================================================

    target_values = df[
        target_column
    ].values.astype(
        np.float32
    )

    # ========================================================
    # Sliding window based ONLY on row count
    # ========================================================

    for start in range(
        len(df) - window_size + 1
    ):

        end = (
            start + window_size
        )

        # ----------------------------------------------------
        # 10 rows × number of input features
        # ----------------------------------------------------

        window = feature_values[
            start:end
        ]

        X.append(
            window
        )

        # ----------------------------------------------------
        # Target corresponding to the LAST row
        # ----------------------------------------------------

        y.append(
            target_values[
                end - 1
            ]
        )

    # ========================================================
    # Convert to NumPy
    # ========================================================

    X = np.asarray(
        X,
        dtype=np.float32
    )

    y = np.asarray(
        y,
        dtype=np.float32
    )

    # ========================================================
    # Safety check
    # ========================================================

    if X.shape[0] == 0:

        raise ValueError(
            "No valid LSTM windows were created."
        )

    print(
        "\n"
        + "=" * 70
    )

    print(
        "WINDOW CREATION"
    )

    print(
        "=" * 70
    )

    print(
        f"Total rows       : {len(df)}"
    )

    print(
        f"Window size      : {window_size}"
    )

    print(
        f"Input features   : {len(input_features)}"
    )

    print(
        f"Windows created  : {len(X)}"
    )

    print(
        f"X shape          : {X.shape}"
    )

    print(
        f"y shape          : {y.shape}"
    )

    return X, y

# ============================================================
# BUILD LSTM
# ============================================================

def build_model(
    window_size,
    feature_count
):

    inputs = Input(
        shape=(
            window_size,
            feature_count
        ),
        name="input_features"
    )

    x = LSTM(
        LSTM_UNITS_1,
        return_sequences=True
    )(inputs)

    x = Dropout(
        DROPOUT
    )(x)

    x = LSTM(
        LSTM_UNITS_2,
        return_sequences=False
    )(x)

    x = Dropout(
        DROPOUT
    )(x)

    x = Dense(
        32,
        activation="relu"
    )(x)

    outputs = Dense(
        1,
        activation="sigmoid",
        name="failure_probability"
    )(x)

    model = Model(
        inputs=inputs,
        outputs=outputs
    )

    model.compile(
        optimizer=Adam(
            learning_rate=LEARNING_RATE,
            clipnorm=1.0
        ),
        loss=tf.keras.losses.Huber(),
        metrics=[
            tf.keras.metrics.MeanAbsoluteError(
                name="mae"
            ),
            tf.keras.metrics.RootMeanSquaredError(
                name="rmse"
            ),
        ]
    )

    return model



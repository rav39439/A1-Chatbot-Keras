def normalize_column_name(column):
    """
    Normalize column names for comparison.

    This is ONLY used for matching.

    The original schema names are preserved for
    dataframe access.
    """

    return (
        str(column)
        .strip()
        .lower()
        .replace(" ", "_")
        .replace("-", "_")
    )


def create_column_mapping(df):
    """
    Create:

        normalized_name -> actual dataframe column name
    """

    mapping = {}

    for column in df.columns:

        normalized = normalize_column_name(
            column
        )

        mapping[normalized] = column

    return mapping


# ============================================================
# LOAD FEATURE SCHEMA
# ============================================================

def load_feature_schema(schema_file):
    """
    Load YOUR exact feature_schema.json structure.

    Example:

    {
        "all_column_count": 39,
        "all_columns": [...],
        "feature_count": 38,
        "feature_columns": [...],
        "timestamp_columns": ["timestamp"],
        "identifier_columns": ["disk_name"],
        "target_column": "failure_probability",
        "excluded_columns": ["failure", "failure_type"]
    }

    The final model features are obtained as:

        feature_columns
            -
        target_column
            -
        timestamp_columns
            -
        identifier_columns
            -
        excluded_columns
    """

    schema_file = Path(schema_file)

    if not schema_file.exists():

        raise FileNotFoundError(
            f"Schema file not found:\n{schema_file}"
        )

    with open(
        schema_file,
        "r",
        encoding="utf-8"
    ) as file:

        schema = json.load(file)

    # ========================================================
    # Validate schema structure
    # ========================================================

    required_schema_keys = [
        "feature_columns",
        "timestamp_columns",
        "identifier_columns",
        "target_column",
        "excluded_columns",
    ]

    for key in required_schema_keys:

        if key not in schema:

            raise ValueError(
                f"Missing '{key}' in feature schema."
            )

    # ========================================================
    # Read schema fields
    # ========================================================

    schema_features = schema[
        "feature_columns"
    ]

    timestamp_columns = schema[
        "timestamp_columns"
    ]

    identifier_columns = schema[
        "identifier_columns"
    ]

    target_column = schema[
        "target_column"
    ]

    excluded_columns = schema[
        "excluded_columns"
    ]

    # ========================================================
    # Normalize only for comparison
    # ========================================================

    schema_features_normalized = [
        normalize_column_name(x)
        for x in schema_features
    ]

    timestamp_normalized = {
        normalize_column_name(x)
        for x in timestamp_columns
    }

    identifier_normalized = {
        normalize_column_name(x)
        for x in identifier_columns
    }

    excluded_normalized = {
        normalize_column_name(x)
        for x in excluded_columns
    }

    target_normalized = normalize_column_name(
        target_column
    )

    # ========================================================
    # IMPORTANT:
    #
    # Remove target/timestamp/identifier/excluded columns
    # from the actual LSTM input features.
    # ========================================================

    input_features = []

    for feature in schema_features:

        normalized = normalize_column_name(
            feature
        )

        if normalized == target_normalized:
            continue

        if normalized in timestamp_normalized:
            continue

        if normalized in identifier_normalized:
            continue

        if normalized in excluded_normalized:
            continue

        input_features.append(
            feature
        )

    # ========================================================
    # Safety checks
    # ========================================================

    input_normalized = {
        normalize_column_name(x)
        for x in input_features
    }

    if target_normalized in input_normalized:

        raise RuntimeError(
            "CRITICAL ERROR: target column "
            f"'{target_column}' is present "
            "in LSTM input features."
        )

    if any(
        normalize_column_name(x)
        in input_normalized
        for x in timestamp_columns
    ):

        raise RuntimeError(
            "CRITICAL ERROR: timestamp column "
            "is present in LSTM input features."
        )

    if any(
        normalize_column_name(x)
        in input_normalized
        for x in identifier_columns
    ):

        raise RuntimeError(
            "CRITICAL ERROR: identifier column "
            "is present in LSTM input features."
        )

    # ========================================================
    # Display
    # ========================================================

    print(
        "\n"
        + "=" * 70
    )

    print(
        "FEATURE SCHEMA"
    )

    print(
        "=" * 70
    )

    print(
        f"Schema all columns : "
        f"{schema.get('all_column_count')}"
    )

    print(
        f"Schema features    : "
        f"{schema.get('feature_count')}"
    )

    print(
        f"Target             : "
        f"{target_column}"
    )

    print(
        f"Timestamp columns  : "
        f"{timestamp_columns}"
    )

    print(
        f"Identifier columns : "
        f"{identifier_columns}"
    )

    print(
        f"Excluded columns   : "
        f"{excluded_columns}"
    )

    print(
        "\nActual LSTM input features:"
    )

    print(
        f"Number of inputs: "
        f"{len(input_features)}"
    )

    for index, feature in enumerate(
        input_features,
        start=1
    ):

        print(
            f"{index:3d}. {feature}"
        )

    return {
        "input_features": input_features,
        "target_column": target_column,
        "timestamp_columns": timestamp_columns,
        "identifier_columns": identifier_columns,
        "excluded_columns": excluded_columns,
    }



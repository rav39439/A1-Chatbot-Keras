def load_txt_file(file_path):

    attempts = [
        {"sep": None, "engine": "python"},
        {"sep": ","},
        {"sep": "\t"},
        {"sep": "|"},
    ]

    last_error = None

    for options in attempts:

        try:

            df = pd.read_csv(
                file_path,
                **options
            )

            if df.shape[1] > 1:

                return df

        except Exception as exc:

            last_error = exc

    raise ValueError(
        f"Unable to read TXT file:\n"
        f"{file_path}\n"
        f"Last error: {last_error}"
    )


def load_data_file(file_path):

    file_path = Path(file_path)

    if not file_path.exists():

        raise FileNotFoundError(
            f"File not found:\n{file_path}"
        )

    extension = file_path.suffix.lower()

    print(
        f"\nLoading file:\n{file_path}"
    )

    if extension in [".xlsx", ".xls"]:

        df = pd.read_excel(
            file_path
        )

    elif extension == ".csv":

        df = pd.read_csv(
            file_path
        )

    elif extension == ".txt":

        df = load_txt_file(
            file_path
        )

    else:

        raise ValueError(
            f"Unsupported file format: "
            f"{extension}"
        )

    if df.empty:

        raise ValueError(
            "Input file contains no rows."
        )

    print(
        f"Loaded {len(df)} rows and "
        f"{len(df.columns)} columns."
    )

    return df


# ============================================================
# MAP DATAFRAME COLUMNS TO SCHEMA
# ============================================================

def map_schema_columns_to_dataframe(
    df,
    schema_columns
):
    """
    Match schema columns against dataframe columns
    without destroying the original column names.

    This allows small formatting differences such as:

        "Read IOPS"
        "read_iops"

    to be matched.
    """

    df_mapping = create_column_mapping(
        df
    )

    resolved = {}

    missing = []

    for schema_column in schema_columns:

        normalized = normalize_column_name(
            schema_column
        )

        if normalized in df_mapping:

            resolved[
                schema_column
            ] = df_mapping[
                normalized
            ]

        else:

            missing.append(
                schema_column
            )

    return resolved, missing



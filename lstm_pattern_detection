import joblib
import numpy as np
import pandas as pd
import tensorflow as tf
from tensorflow.keras.models import load_model


# ============================================================
# LOAD MODEL + SCALER + SCHEMA
# ============================================================

def load_prediction_artifacts(
    model_dir="./failure_probability_model",
    schema_path="./data/feature_schema.json"
):
    """
    Load:
        - trained LSTM model
        - MinMaxScaler used during training
        - feature schema
    """

    model_path = os.path.join(
        model_dir,
        "failure_probability_lstm.keras"
    )

    scaler_path = os.path.join(
        model_dir,
        "feature_scaler.pkl"
    )

    if not os.path.exists(model_path):
        raise FileNotFoundError(
            f"Model not found: {model_path}"
        )

    if not os.path.exists(scaler_path):
        raise FileNotFoundError(
            f"Scaler not found: {scaler_path}"
        )

    if not os.path.exists(schema_path):
        raise FileNotFoundError(
            f"Schema not found: {schema_path}"
        )

    # Load trained model
    model = load_model(
        model_path
    )

    # Load the SAME scaler used during training
    scaler = joblib.load(
        scaler_path
    )

    # Load schema
    with open(
        schema_path,
        "r"
    ) as f:
        schema_info = json.load(f)

    print("\n" + "=" * 70)
    print("PREDICTION ARTIFACTS LOADED")
    print("=" * 70)

    print(
        f"Model path  : {model_path}"
    )

    print(
        f"Scaler path : {scaler_path}"
    )

    print(
        f"Input shape : {model.input_shape}"
    )

    print(
        f"Output shape: {model.output_shape}"
    )

    return (
        model,
        scaler,
        schema_info
    )


# ============================================================
# LOAD 10 ROWS AND PREDICT
# ============================================================
def load_and_predict(
    excel_path,
    model_dir="./failure_probability_model",
    schema_path="./data/feature_schema.json",
    sample_size=10
):
    """
    Load prediction Excel and apply EXACTLY the same preprocessing
    that was used during LSTM training.

    Training preprocessing:
        1. timestamp -> Unix seconds
        2. remove target / identifiers / excluded columns
        3. pd.to_numeric(errors="coerce")
        4. replace inf/-inf with NaN
        5. linear interpolation
        6. fill remaining NaN with 0
        7. saved MinMaxScaler.transform()
    """

    # ========================================================
    # LOAD MODEL, SCALER AND SCHEMA
    # ========================================================

    model, scaler, schema_info = load_prediction_artifacts(
        model_dir
    )

    # ========================================================
    # LOAD EXCEL
    # ========================================================

    df = pd.read_excel(
        excel_path
    )

    if df.empty:
        raise ValueError(
            "Prediction Excel file is empty."
        )

    df.columns = (
        df.columns
        .astype(str)
        .str.strip()
    )

    print("\n" + "=" * 80)
    print("PREDICTION INPUT")
    print("=" * 80)

    print(
        f"Rows    : {len(df)}"
    )

    print(
        f"Columns : {len(df.columns)}"
    )

    # ========================================================
    # SCHEMA INFORMATION
    # ========================================================

    schema_columns = schema_info.get(
        "feature_columns",
        []
    )

    if not schema_columns:
        raise ValueError(
            "feature_columns not found in schema."
        )

    target_column = schema_info.get(
        "target_column",
        "failure_probability"
    )

    timestamp_columns = schema_info.get(
        "timestamp_columns",
        ["timestamp"]
    )

    identifier_columns = schema_info.get(
        "identifier_columns",
        ["disk_name"]
    )

    excluded_columns = schema_info.get(
        "excluded_columns",
        ["failure", "failure_type"]
    )

    # ========================================================
    # DETERMINE ACTUAL MODEL INPUT FEATURES
    #
    # EXACTLY LIKE TRAINING
    # ========================================================

    columns_to_exclude = set(
        [target_column]
        + timestamp_columns
        + identifier_columns
        + excluded_columns
    )

    input_features = [
        column
        for column in schema_columns
        if column not in columns_to_exclude
    ]

    print(
        f"\nModel input features: {len(input_features)}"
    )

    for column in input_features:
        print(
            f"  - {column}"
        )

    # ========================================================
    # CHECK REQUIRED FEATURES
    # ========================================================

    missing_features = [
        column
        for column in input_features
        if column not in df.columns
    ]

    if missing_features:

        raise ValueError(
            "Prediction Excel is missing required "
            "training features:\n\n"
            + "\n".join(
                str(column)
                for column in missing_features
            )
        )

    # ========================================================
    # TIMESTAMP
    #
    # EXACT SAME TRANSFORMATION AS TRAINING
    # ========================================================

    for column in timestamp_columns:

        if column not in df.columns:
            continue

        timestamp_values = pd.to_datetime(
            df[column],
            errors="coerce"
        )

        numeric_timestamp = (
            timestamp_values.astype("int64")
            / 1_000_000_000
        )

        numeric_timestamp[
            timestamp_values.isna()
        ] = np.nan

        df[column] = numeric_timestamp.astype(
            "float64"
        )

    # ========================================================
    # SORT BY TIMESTAMP
    #
    # Only for chronological ordering.
    # Timestamp itself is NOT sent to the model.
    # ========================================================

    if timestamp_columns:

        timestamp_column = timestamp_columns[0]

        if timestamp_column in df.columns:

            sort_timestamp = pd.to_datetime(
                df[timestamp_column],
                unit="s",
                errors="coerce"
            )

            df["_sort_timestamp"] = sort_timestamp

            df = (
                df.sort_values(
                    "_sort_timestamp"
                )
                .drop(
                    columns=["_sort_timestamp"]
                )
                .reset_index(drop=True)
            )

    # ========================================================
    # TAKE REQUIRED NUMBER OF ROWS
    # ========================================================

    window_size = int(
        model.input_shape[1]
    )

    if sample_size is None:
        sample_size = window_size

    sample_size = int(sample_size)

    # Use the latest rows if more rows are available
    if len(df) >= sample_size:

        sample_df = (
            df.iloc[-sample_size:]
            .copy()
        )

    else:

        # ----------------------------------------------------
        # If fewer than WINDOW_SIZE rows are available,
        # repeat the first row at the beginning.
        # ----------------------------------------------------

        if len(df) == 0:
            raise ValueError(
                "No rows available for prediction."
            )

        rows_needed = (
            window_size - len(df)
        )

        first_row = df.iloc[
            [0]
        ].copy()

        padding = pd.concat(
            [first_row] * rows_needed,
            ignore_index=True
        )

        sample_df = pd.concat(
            [
                padding,
                df
            ],
            ignore_index=True
        )

        print(
            f"\nOnly {len(df)} rows available."
        )

        print(
            f"Added {rows_needed} "
            f"padding rows."
        )

    # Make absolutely sure we have the model window
    if len(sample_df) > window_size:

        sample_df = sample_df.iloc[
            -window_size:
        ].copy()

    # ========================================================
    # EXACT TRAINING FEATURE SELECTION
    #
    # IMPORTANT:
    # Do NOT use disk_name
    # Do NOT use target
    # Do NOT use timestamp
    # ========================================================

    feature_df = (
        sample_df[
            input_features
        ]
        .copy()
    )

    print(
        "\nRaw model feature dtypes:"
    )

    print(
        feature_df.dtypes
    )

    # ========================================================
    # EXACT SAME NUMERIC CONVERSION AS TRAINING
    #
    # This is the important part.
    #
    # Training uses:
    #
    # dataframe_to_numeric()
    #
    # which performs:
    #
    # pd.to_numeric(errors='coerce')
    # interpolate()
    # fillna(0)
    # ========================================================

    for column in feature_df.columns:

        feature_df[column] = pd.to_numeric(
            feature_df[column],
            errors="coerce"
        )

    # ========================================================
    # REPLACE INFINITY
    # ========================================================

    feature_df = feature_df.replace(
        [np.inf, -np.inf],
        np.nan
    )

    # ========================================================
    # SAME INTERPOLATION AS TRAINING
    # ========================================================

    feature_df = feature_df.interpolate(
        method="linear",
        limit_direction="both"
    )

    # ========================================================
    # SAME NaN HANDLING AS TRAINING
    # ========================================================

    feature_df = feature_df.fillna(
        0
    )

    # ========================================================
    # FINAL NUMERIC VALIDATION
    # ========================================================

    non_numeric_columns = [
        column
        for column in feature_df.columns
        if not pd.api.types.is_numeric_dtype(
            feature_df[column]
        )
    ]

    if non_numeric_columns:

        raise ValueError(
            "Non-numeric columns remain after applying "
            "the exact training preprocessing:\n"
            + "\n".join(
                non_numeric_columns
            )
        )

    if feature_df.isna().any().any():

        bad_columns = (
            feature_df.columns[
                feature_df.isna().any()
            ]
            .tolist()
        )

        raise ValueError(
            "NaN values remain after preprocessing:\n"
            + "\n".join(
                bad_columns
            )
        )

    # ========================================================
    # CONVERT TO FLOAT32
    # ========================================================

    feature_values = (
        feature_df
        .values
        .astype(np.float32)
    )

    print(
        f"\nPreprocessed feature shape: "
        f"{feature_values.shape}"
    )

    # ========================================================
    # CHECK FEATURE COUNT
    # ========================================================

    expected_features = (
        scaler.n_features_in_
    )

    actual_features = (
        feature_values.shape[1]
    )

    if actual_features != expected_features:

        raise ValueError(
            f"Feature count mismatch.\n"
            f"Training scaler expects: "
            f"{expected_features}\n"
            f"Prediction contains: "
            f"{actual_features}\n\n"
            f"Features used:\n"
            + "\n".join(
                input_features
            )
        )

    # ========================================================
    # SAME MINMAX SCALER USED DURING TRAINING
    # ========================================================

    X_scaled = scaler.transform(
        feature_values
    ).astype(
        np.float32
    )

    # ========================================================
    # LSTM INPUT
    #
    # (1, WINDOW_SIZE, FEATURES)
    # ========================================================

    X_input = X_scaled[
        np.newaxis,
        :,
        :
    ]

    print(
        f"LSTM input shape : "
        f"{X_input.shape}"
    )

    print(
        f"Model input shape: "
        f"{model.input_shape}"
    )

    # ========================================================
    # FINAL SHAPE CHECK
    # ========================================================

    if X_input.shape[1] != model.input_shape[1]:

        raise ValueError(
            f"Window size mismatch.\n"
            f"Expected: {model.input_shape[1]}\n"
            f"Received: {X_input.shape[1]}"
        )

    if X_input.shape[2] != model.input_shape[2]:

        raise ValueError(
            f"Feature count mismatch.\n"
            f"Expected: {model.input_shape[2]}\n"
            f"Received: {X_input.shape[2]}"
        )

    # ========================================================
    # PREDICTION
    # ========================================================

    prediction = model.predict(
        X_input,
        verbose=0
    )

    failure_probability = float(
        prediction[0][0]
    )

    failure_probability = float(
        np.clip(
            failure_probability,
            0.0,
            1.0
        )
    )

    # ========================================================
    # RESULT
    # ========================================================

    print("\n" + "=" * 80)
    print("PREDICTION RESULT")
    print("=" * 80)

    print(
        f"Failure Probability : "
        f"{failure_probability:.6f}"
    )

    print(
        f"Window Size         : "
        f"{X_input.shape[1]}"
    )

    print(
        f"Feature Count       : "
        f"{X_input.shape[2]}"
    )

    print("=" * 80)

    return failure_probability



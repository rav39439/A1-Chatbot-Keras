print("Warmup steps:", WARMUP_STEPS)


# =========================================================
# 10. LOAD PRETRAINED GPT-2
# =========================================================

print("\nLoading pretrained GPT-2 model...")

MODEL_SOURCE = (
    RESUME_CHECKPOINT
    if RESUME_TRAINING

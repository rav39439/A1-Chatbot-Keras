    )

    scaler.load_state_dict(
        checkpoint["scaler"]
    )

    start_epoch = (
        checkpoint["epoch"] + 1
    )

    global_step = checkpoint["global_step"]

    print("\nPrevious training restored.")

    print("Starting epoch:", start_epoch + 1)

    print("Global step:", global_step)


# =========================================================
# 17. TRAINING FUNCTION
# =========================================================

def train_one_epoch(
    model,
    loader,
    epoch
):

    model.train()

    total_loss = 0.0

    optimizer.zero_grad(
        set_to_none=True
    )

    for step, batch in enumerate(loader):

        input_ids = batch["input_ids"].to(
            device,
            non_blocking=True
        )

        attention_mask = batch["attention_mask"].to(
            device,
            non_blocking=True
        )

        labels = batch["labels"].to(
            device,
            non_blocking=True
        )

        # Correct scaling for the final incomplete
        # gradient accumulation group.

        group_start = (
            step // GRADIENT_ACCUMULATION_STEPS
        ) * GRADIENT_ACCUMULATION_STEPS

        group_size = min(
            GRADIENT_ACCUMULATION_STEPS,
            len(loader) - group_start
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP,
            dtype=torch.float16
        ):

            outputs = model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                labels=labels
            )

            # GPT-2 automatically shifts labels
            # internally for next-token prediction.

            loss = outputs.loss

            scaled_loss = loss / group_size

        scaler.scale(
            scaled_loss
        ).backward()

        total_loss += loss.item()

        is_update_step = (
            (step + 1) % GRADIENT_ACCUMULATION_STEPS == 0
            or (step + 1) == len(loader)
        )

        if is_update_step:

            scaler.unscale_(optimizer)

            torch.nn.utils.clip_grad_norm_(
                [
                    p for p in model.parameters()
                    if p.requires_grad
                ],
                MAX_GRAD_NORM
            )

            scaler.step(optimizer)

            scaler.update()

            optimizer.zero_grad(
                set_to_none=True
            )

            scheduler.step()

            global_step += 1

        if (step + 1) % 50 == 0:

            print(
                f"Epoch {epoch + 1}/{EPOCHS} | "
                f"Step {step + 1}/{len(loader)} | "
                f"Loss: {loss.item():.4f} | "
                f"LR: {scheduler.get_last_lr()[0]:.8f}"
            )

    return total_loss / len(loader)


# =========================================================
# 18. VALIDATION FUNCTION
# =========================================================

@torch.no_grad()
def evaluate_model(
    model,
    loader
):

    model.eval()

    total_loss = 0.0

    total_batches = 0

    correct_tokens = 0

    total_tokens = 0

    for batch in loader:

        input_ids = batch["input_ids"].to(
            device,
            non_blocking=True
        )

        attention_mask = batch["attention_mask"].to(
            device,
            non_blocking=True
        )

        labels = batch["labels"].to(
            device,
            non_blocking=True
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP,
            dtype=torch.float16
        ):

            outputs = model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                labels=labels
            )

            loss = outputs.loss

        total_loss += loss.item()

        total_batches += 1

        # Compare next-token predictions against
        # answer-only labels, excluding ignored positions.

        predictions = outputs.logits[:, :-1, :].argmax(
            dim=-1
        )

        targets = labels[:, 1:]

        valid_mask = targets != -100

        correct_tokens += (
            (
                predictions == targets
            ) & valid_mask
        ).sum().item()

        total_tokens += valid_mask.sum().item()

    average_loss = (
        total_loss / max(total_batches, 1)
    )

    accuracy = (
        correct_tokens / total_tokens
        if total_tokens > 0
        else 0.0
    )

    perplexity = math.exp(
        min(average_loss, 20)
    )

    return {
        "loss": average_loss,
        "accuracy": accuracy,
        "perplexity": perplexity
    }



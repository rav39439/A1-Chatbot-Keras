# 12. TRAINING FUNCTION
# =========================================================

def train_one_epoch(
    model,
    loader,
    optimizer,
    scheduler,
    scaler,
    epoch
):

    model.train()

    total_loss = 0.0

    iterator = iter(loader)

    for step in range(steps_per_epoch):

        input_ids = next(iterator)

        input_ids = input_ids.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(set_to_none=True)

        with torch.cuda.amp.autocast(
            enabled=USE_AMP
        ):

            outputs = model(
                input_ids=input_ids,

                # The model internally shifts these
                # labels for next-token prediction.

                labels=input_ids
            )

            loss = outputs.loss

        scaler.scale(loss).backward()

        scaler.unscale_(optimizer)

        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            MAX_GRAD_NORM
        )

        scaler.step(optimizer)

        scaler.update()

        scheduler.step()

        total_loss += loss.item()

        current_lr = scheduler.get_last_lr()[0]

        if (step + 1) % 100 == 0:

            print(
                f"Epoch {epoch + 1} | "
                f"Step {step + 1}/{steps_per_epoch} | "
                f"Loss: {loss.item():.4f} | "
                f"LR: {current_lr:.8f}"
            )

    average_loss = total_loss / steps_per_epoch

    return average_loss


# =========================================================
# 13. VALIDATION FUNCTION
# =========================================================

@torch.no_grad()
def evaluate_model(
    model,
    loader
):

    model.eval()

    total_loss = 0.0

    total_correct = 0
    total_tokens = 0

    for step, input_ids in enumerate(loader):

        if step >= validation_steps:
            break

        input_ids = input_ids.to(
            device,
            non_blocking=True
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP
        ):

            outputs = model(
                input_ids=input_ids,
                labels=input_ids
            )

            loss = outputs.loss

        total_loss += (
            loss.item() * input_ids.size(0)
        )

        # GPT-2 predicts the next token.
        # Compare each position's prediction
        # against the following actual token.

        predictions = outputs.logits[:, :-1, :].argmax(
            dim=-1
        )

        targets = input_ids[:, 1:]

        total_correct += (
            predictions == targets
        ).sum().item()

        total_tokens += targets.numel()

    processed_samples = min(
        validation_steps * BATCH_SIZE,
        len(loader.dataset)
    )

    average_loss = total_loss / processed_samples

    accuracy = (
        total_correct / total_tokens
        if total_tokens > 0
        else 0.0
    )

    perplexity = math.exp(
        min(average_loss, 20)
    )

    return {
        "loss": average_loss,
        "accuracy": accuracy,
        "perplexity": perplexity
    }



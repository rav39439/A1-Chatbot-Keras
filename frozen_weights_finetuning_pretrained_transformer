        "Insufficient training or validation batches."
    )

TOTAL_STEPS = steps_per_epoch * EPOCHS

print("\nTraining configuration:")

print("Batch size:", BATCH_SIZE)

print("Steps per epoch:", steps_per_epoch)

print("Validation steps:", validation_steps)

print("Epochs:", EPOCHS)

print("Total optimizer steps:", TOTAL_STEPS)


# =========================================================
# 8. LOAD PRETRAINED GPT-2
# =========================================================

print("\nLoading pretrained GPT-2...")

if RESUME_CHECKPOINT_DIR is not None:

    MODEL_SOURCE = RESUME_CHECKPOINT_DIR

    if not os.path.exists(
        os.path.join(MODEL_SOURCE, "config.json")
    ):

        raise FileNotFoundError(
            "GPT-2 config.json not found."
        )

else:

    MODEL_SOURCE = MODEL_NAME


model = AutoModelForCausalLM.from_pretrained(
    MODEL_SOURCE
)

model.config.use_cache = False

model.config.pad_token_id = tokenizer.pad_token_id

MODEL_CONTEXT = model.config.n_positions

if SEQ_LEN > MODEL_CONTEXT:

    raise ValueError(
        f"SEQ_LEN={SEQ_LEN} exceeds GPT-2 "
        f"context window={MODEL_CONTEXT}."
    )


# =========================================================
# 9. FREEZE GPT-2 PARAMETERS
# =========================================================

print("\nApplying layer freezing...")

# Freeze every parameter first.

for param in model.parameters():

    param.requires_grad = False


# GPT-2 transformer blocks.

total_layers = len(model.transformer.h)

if NUM_TRAINABLE_LAYERS < 1:

    raise ValueError(
        "NUM_TRAINABLE_LAYERS must be at least 1."
    )

if NUM_TRAINABLE_LAYERS > total_layers:

    raise ValueError(
        "NUM_TRAINABLE_LAYERS exceeds total GPT-2 layers."
    )


# Calculate the first trainable layer.

freeze_until = (
    total_layers - NUM_TRAINABLE_LAYERS
)


# Unfreeze only the final transformer blocks.

for layer_index in range(
    freeze_until,
    total_layers
):

    for param in model.transformer.h[layer_index].parameters():

        param.requires_grad = True


# Train final layer normalization.

for param in model.transformer.ln_f.parameters():

    param.requires_grad = True


# Embeddings remain frozen.
# GPT-2 LM head shares its weights with token embeddings.

if FREEZE_EMBEDDINGS:

    for param in model.transformer.wte.parameters():

        param.requires_grad = False

    for param in model.transformer.wpe.parameters():

        param.requires_grad = False


# Move model to device.

model.to(device)


# =========================================================
# 10. PARAMETER STATISTICS
# =========================================================

total_parameters = sum(
    p.numel()
    for p in model.parameters()
)

trainable_parameters = sum(
    p.numel()
    for p in model.parameters()
    if p.requires_grad
)

frozen_parameters = (
    total_parameters - trainable_parameters
)

print("\n========== MODEL OPTIMIZATION ==========")

print("Total layers:", total_layers)

print("Frozen layers:", freeze_until)

print("Trainable layers:", NUM_TRAINABLE_LAYERS)

print("Total parameters:", f"{total_parameters:,}")

print("Frozen parameters:", f"{frozen_parameters:,}")

print("Trainable parameters:", f"{trainable_parameters:,}")

print(
    "Trainable percentage:",
    round(
        trainable_parameters /
        total_parameters * 100,
        2
    ),
    "%"
)

print("========================================")


# =========================================================
# 11. OPTIMIZER
# =========================================================

# Only trainable parameters enter AdamW.

trainable_params = [
    p
    for p in model.parameters()
    if p.requires_grad
]

optimizer = torch.optim.AdamW(
    trainable_params,
    lr=INITIAL_LR,
    weight_decay=WEIGHT_DECAY
)


# =========================================================
# 12. WARMUP + COSINE LR SCHEDULE
# =========================================================

def lr_lambda(current_step):

    if current_step < WARMUP_STEPS:

        return max(
            (current_step + 1) /
            max(WARMUP_STEPS, 1),
            1e-8
        )

    progress = (
        current_step - WARMUP_STEPS
    ) / max(
        TOTAL_STEPS - WARMUP_STEPS,
        1
    )

    progress = min(
        max(progress, 0.0),
        1.0
    )

    cosine = 0.5 * (
        1.0 + math.cos(math.pi * progress)
    )

    lr = (
        MIN_LR
        + (INITIAL_LR - MIN_LR) * cosine
    )

    return lr / INITIAL_LR


scheduler = torch.optim.lr_scheduler.LambdaLR(
    optimizer,
    lr_lambda
)


# Mixed precision scaler.

scaler = torch.cuda.amp.GradScaler(
    enabled=USE_AMP
)


# =========================================================
# 13. RESUME PREVIOUS TRAINING
# =========================================================

start_epoch = 0

global_step = 0

if RESUME_CHECKPOINT_DIR is not None:

    state_path = os.path.join(
        RESUME_CHECKPOINT_DIR,
        "training_state.pt"
    )

    if not os.path.exists(state_path):

        raise FileNotFoundError(

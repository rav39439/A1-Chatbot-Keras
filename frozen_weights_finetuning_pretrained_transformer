class NextTokenDataset(Dataset):

    def __init__(
        self,
        token_array,
        seq_len,
        stride
    ):

        self.tokens = token_array

        self.seq_len = seq_len
        self.stride = stride

        self.starts = np.arange(
            0,
            len(token_array) - seq_len + 1,
            stride,
            dtype=np.int64
        )

    def __len__(self):

        return len(self.starts)

    def __getitem__(self, index):

        start = self.starts[index]

        end = start + self.seq_len

        sequence = self.tokens[start:end]

        return torch.tensor(
            sequence.astype(np.int64),
            dtype=torch.long
        )



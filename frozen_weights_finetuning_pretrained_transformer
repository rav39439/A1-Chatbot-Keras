    )

print("GPT-2 loaded successfully.")

print("Transformer layers:", model.config.n_layer)

print("Hidden dimension:", model.config.n_embd)


# =========================================================
# 11. FREEZE LOWER TRANSFORMER LAYERS
# =========================================================

def configure_trainable_layers(model):

    transformer = model.transformer

    total_layers = len(
        transformer.h
    )

    if NUM_FROZEN_LAYERS >= total_layers:
        raise ValueError(
            "At least one Transformer layer must remain trainable."
        )

    # -----------------------------------------------------
    # Freeze token embeddings
    # -----------------------------------------------------

    transformer.wte.weight.requires_grad = False

    # -----------------------------------------------------
    # Freeze positional embeddings
    # -----------------------------------------------------

    transformer.wpe.weight.requires_grad = False

    # -----------------------------------------------------
    # Freeze first 8 Transformer blocks
    # -----------------------------------------------------

    for i in range(NUM_FROZEN_LAYERS):

        for parameter in transformer.h[i].parameters():

            parameter.requires_grad = False

    # -----------------------------------------------------
    # Unfreeze last 4 Transformer blocks
    # -----------------------------------------------------

    for i in range(
        NUM_FROZEN_LAYERS,
        total_layers
    ):

        for parameter in transformer.h[i].parameters():

            parameter.requires_grad = True

    # -----------------------------------------------------
    # Train final layer normalization
    # -----------------------------------------------------

    for parameter in transformer.ln_f.parameters():

        parameter.requires_grad = True

    # -----------------------------------------------------
    # LM HEAD
    # -----------------------------------------------------

    # GPT-2 ties lm_head weights to token embeddings.
    # Since embeddings are frozen, the tied head is frozen too.

    print("\nLayer trainability:")

    for i, layer in enumerate(transformer.h):

        trainable = any(
            p.requires_grad
            for p in layer.parameters()
        )

        status = (
            "TRAINABLE"
            if trainable
            else "FROZEN"
        )

        print(
            f"Transformer layer {i + 1:02d}: {status}"
        )

    print("Token embeddings: FROZEN")
    print("Position embeddings: FROZEN")
    print("Final layer norm: TRAINABLE")
    print("Tied LM head: FROZEN")


configure_trainable_layers(model)

model.to(device)



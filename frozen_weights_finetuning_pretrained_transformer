print("PAD ID:", PAD_ID)
print("EOS ID:", EOS_ID)


# =========================================================
# 4. INSTRUCTION FORMAT
# =========================================================

QUESTION_PREFIX_IDS = tokenizer.encode(
    "Question: ",
    add_special_tokens=False
)

ANSWER_PREFIX_IDS = tokenizer.encode(
    "\nAnswer: ",
    add_special_tokens=False
)

END_IDS = tokenizer.encode(
    "\nEnd of answer.",
    add_special_tokens=False
)

print("\nInstruction formatting initialized.")


# =========================================================
# 5. ENCODE QUESTION-ANSWER PAIRS
# =========================================================

def encode_qa(
    question,
    answer,
    seq_len
):

    question_ids = tokenizer.encode(
        question,
        add_special_tokens=False
    )

    answer_ids = tokenizer.encode(
        answer,
        add_special_tokens=False
    )

    # Reserve space for:
    # Question prefix
    # Answer prefix
    # Ending phrase
    # EOS
    # At least one answer token

    fixed_overhead = (
        len(QUESTION_PREFIX_IDS)
        + len(ANSWER_PREFIX_IDS)
        + len(END_IDS)
        + 1
    )

    max_question_tokens = max(
        0,
        seq_len - fixed_overhead - 1
    )

    question_ids = question_ids[
        :max_question_tokens
    ]

    prompt_ids = (
        QUESTION_PREFIX_IDS
        + question_ids
        + ANSWER_PREFIX_IDS
    )

    answer_capacity = (
        seq_len
        - len(prompt_ids)
        - len(END_IDS)
        - 1
    )

    if answer_capacity < 1:
        return None

    answer_ids = answer_ids[
        :answer_capacity
    ]

    if not answer_ids:
        return None

    # Complete sequence.

    token_ids = (
        prompt_ids
        + answer_ids
        + END_IDS
        + [EOS_ID]
    )

    # -----------------------------------------------------
    # ANSWER-ONLY LABELS
    # -----------------------------------------------------

    # Ignore all question and answer-prefix tokens.
    # Train only answer, ending phrase and EOS.

    labels = (
        [-100] * len(prompt_ids)
        + answer_ids
        + END_IDS
        + [EOS_ID]
    )

    # -----------------------------------------------------
    # ATTENTION MASK
    # -----------------------------------------------------

    attention_mask = [1] * len(token_ids)

    # -----------------------------------------------------
    # PADDING
    # -----------------------------------------------------

    padding_length = seq_len - len(token_ids)

    if padding_length < 0:
        return None

    token_ids += (
        [PAD_ID] * padding_length
    )

    attention_mask += (
        [0] * padding_length
    )

    labels += (
        [-100] * padding_length
    )

    return (
        token_ids,
        attention_mask,
        labels
    )


# =========================================================
# 6. BUILD ENCODED DATASET
# =========================================================

print("\nEncoding QA examples...")

examples = []

for index, (question, answer) in enumerate(qa_pairs):


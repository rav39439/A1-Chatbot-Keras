def save_checkpoint(
    model,
    tokenizer,
    optimizer,
    scheduler,
    scaler,
    epoch,
    global_step
):

    os.makedirs(
        CHECKPOINT_DIR,
        exist_ok=True
    )

    # Save model weights and configuration.

    model.save_pretrained(
        CHECKPOINT_DIR,
        safe_serialization=True
    )

    tokenizer.save_pretrained(
        CHECKPOINT_DIR
    )

    # Save optimizer separately.

    state = {
        "epoch": epoch,
        "global_step": global_step,
        "optimizer": optimizer.state_dict(),
        "scheduler": scheduler.state_dict(),
        "scaler": scaler.state_dict()
    }

    torch.save(
        state,
        os.path.join(
            CHECKPOINT_DIR,
            "training_state.pt"
        )
    )

    print(
        "\nCheckpoint saved:",
        CHECKPOINT_DIR
    )



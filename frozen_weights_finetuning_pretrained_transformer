    print("\nRestoring training state...")

    state = torch.load(
        state_path,
        map_location=device,
        weights_only=False
    )

    optimizer.load_state_dict(
        state["optimizer"]
    )

    scheduler.load_state_dict(
        state["scheduler"]
    )

    if "scaler" in state:

        scaler.load_state_dict(
            state["scaler"]
        )

    start_epoch = state["epoch"] + 1

    global_step = state["global_step"]

    print("Previous epoch:", state["epoch"] + 1)

    print("Resuming from epoch:", start_epoch)

    print("Global step:", global_step)

    del state

    print("Training state restored.")

else:

    print("\nStarting fresh GPT-2 fine-tuning.")

    print("Loading original pretrained GPT-2 weights.")


# =========================================================
# 14. KEEP FROZEN LAYERS IN EVALUATION MODE
# =========================================================

def set_training_mode(model):

    model.train()

    # Frozen transformer blocks must not use dropout.

    for layer_index in range(freeze_until):

        model.transformer.h[layer_index].eval()

    # Embeddings are frozen.

    if FREEZE_EMBEDDINGS:

        model.transformer.wte.eval()

        model.transformer.wpe.eval()

    # Disable embedding dropout.

    model.transformer.drop.eval()


# =========================================================
# 15. TRAINING FUNCTION
# =========================================================

def train_one_epoch(
    model,
    loader,
    optimizer,
    scheduler,
    scaler,
    epoch
):

    set_training_mode(model)

    total_loss = 0.0

    iterator = iter(loader)

    for step in range(steps_per_epoch):

        input_ids = next(iterator)

        input_ids = input_ids.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP
        ):

            outputs = model(
                input_ids=input_ids,

                # GPT-2 internally shifts labels
                # for causal next-token prediction.

                labels=input_ids
            )

            loss = outputs.loss

        scaler.scale(loss).backward()

        scaler.unscale_(optimizer)

        # Clip only trainable parameters.

        torch.nn.utils.clip_grad_norm_(
            trainable_params,
            MAX_GRAD_NORM
        )

        scaler.step(optimizer)

        scaler.update()

        scheduler.step()

        total_loss += loss.item()

        current_lr = scheduler.get_last_lr()[0]

        if (step + 1) % 100 == 0:

            print(
                f"Epoch {epoch + 1} | "
                f"Step {step + 1}/{steps_per_epoch} | "
                f"Loss: {loss.item():.4f} | "
                f"LR: {current_lr:.8f}"
            )

    average_loss = (
        total_loss / steps_per_epoch
    )

    return average_loss


# =========================================================
# 16. VALIDATION FUNCTION
# =========================================================

@torch.no_grad()
def evaluate_model(
    model,
    loader
):

    model.eval()

    total_loss = 0.0

    total_correct = 0

    total_tokens = 0

    processed_samples = 0

    for step, input_ids in enumerate(loader):

        if step >= validation_steps:

            break

        input_ids = input_ids.to(
            device,
            non_blocking=True
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP
        ):

            outputs = model(
                input_ids=input_ids,
                labels=input_ids
            )

            loss = outputs.loss

        batch_size = input_ids.size(0)

        total_loss += (
            loss.item() * batch_size
        )

        processed_samples += batch_size

        # Next-token prediction.

        predictions = outputs.logits[:, :-1, :].argmax(
            dim=-1
        )

        targets = input_ids[:, 1:]

        total_correct += (
            predictions == targets
        ).sum().item()

        total_tokens += targets.numel()

    average_loss = (
        total_loss / processed_samples
        if processed_samples > 0
        else 0.0
    )

    accuracy = (
        total_correct / total_tokens
        if total_tokens > 0
        else 0.0
    )

    perplexity = math.exp(
        min(average_loss, 20)
    )

    return {
        "loss": average_loss,
        "accuracy": accuracy,
        "perplexity": perplexity
    }


# =========================================================
# 17. CHECKPOINT SAVING
# =========================================================

def save_checkpoint(
    model,
    tokenizer,
    optimizer,
    scheduler,
    scaler,
    epoch,
    global_step
):

    os.makedirs(
        CHECKPOINT_DIR,
        exist_ok=True
    )

    # Save the complete model in original precision.

    model.save_pretrained(
        CHECKPOINT_DIR,
        safe_serialization=True
    )

    tokenizer.save_pretrained(
        CHECKPOINT_DIR
    )

    # Save optimizer and scheduler separately.

    state = {

        "epoch": epoch,

        "global_step": global_step,

        "optimizer": optimizer.state_dict(),

        "scheduler": scheduler.state_dict(),

        "scaler": scaler.state_dict(),

        "num_trainable_layers": NUM_TRAINABLE_LAYERS,

        "freeze_embeddings": FREEZE_EMBEDDINGS
    }

    torch.save(
        state,
        os.path.join(
            CHECKPOINT_DIR,
            "training_state.pt"
        )
    )

    print(
        "\nCheckpoint saved:",
        CHECKPOINT_DIR
    )


# =========================================================
# 18. START TRAINING
# =========================================================


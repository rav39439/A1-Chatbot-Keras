# ============================================================
# 3. FLICKR30K DATASET
# ============================================================

class FlickrImageDataset(Dataset):

    def __init__(
        self,
        image_root,
        transform=None,
        dataframe=None
    ):

        self.image_root = image_root
        self.transform = transform

        if dataframe is None:

            # Flickr30k result.csv format:
            #
            # image_name | comment_number | comment
            #
            # Example:
            # 1000092795.jpg | 0 | Two young guys...
            #
            # It is pipe-separated, NOT comma-separated.

            self.df = pd.read_csv(
                CAPTION_PATH,
                sep="|",
                encoding="utf-8",
                dtype=str,
                skipinitialspace=True
            )

            # Remove whitespace from column names.
            self.df.columns = [
                str(col).strip()
                for col in self.df.columns
            ]

            # Normalize column names.
            self.df = self.df.rename(
                columns={
                    "image_name": "image",
                    "comment_number": "caption_number",
                    "comment": "caption"
                }
            )

        else:

            self.df = dataframe.copy()

        required_columns = {
            "image",
            "caption"
        }

        if not required_columns.issubset(
            self.df.columns
        ):

            raise ValueError(
                "Unexpected result.csv format. "
                f"Found columns: {self.df.columns.tolist()}"
            )

        # Clean image filenames and captions.

        self.df["image"] = (
            self.df["image"]
            .astype(str)
            .str.strip()
        )

        self.df["caption"] = (
            self.df["caption"]
            .astype(str)
            .str.strip()
        )

        # Remove missing values.

        self.df = self.df.dropna(
            subset=["image", "caption"]
        )

        self.df = self.df[
            (self.df["image"] != "") &
            (self.df["caption"] != "") &
            (self.df["image"].str.lower() != "nan") &
            (self.df["caption"].str.lower() != "nan")
        ].reset_index(drop=True)

        # Keep only records with existing JPG images.

        self.df = self.df[
            self.df["image"].apply(
                lambda name: os.path.isfile(
                    os.path.join(
                        self.image_root,
                        name
                    )
                )
            )
        ].reset_index(drop=True)

        print(
            "Valid image-caption pairs:",
            len(self.df)
        )

        print(
            "Unique images:",
            self.df["image"].nunique()
        )

    def __len__(self):

        return len(self.df)

    def __getitem__(self, index):

        row = self.df.iloc[index]

        image_name = row["image"]

        caption = row["caption"]

        image_path = os.path.join(
            self.image_root,
            image_name
        )

        with Image.open(image_path) as img:

            image = img.convert("RGB")

        if self.transform is not None:

            image = self.transform(image)

        return {
            "pixel_values": image,
            "caption": caption
        }



# ============================================================
# 12. TEXT EMBEDDING
# ============================================================

def encode_captions(captions):

    tokens = tokenizer(
        captions,
        padding="max_length",
        max_length=MAX_LENGTH,
        truncation=True,
        return_tensors="pt"
    )

    input_ids = tokens.input_ids.to(DEVICE)

    attention_mask = tokens.attention_mask.to(DEVICE)

    # No gradient computation for frozen T5.

    with torch.no_grad():

        embeddings = text_encoder(
            input_ids=input_ids,
            attention_mask=attention_mask
        ).last_hidden_state

    return embeddings, attention_mask


# ============================================================
# 13. DIFFUSION TRAINING LOSS
# ============================================================

def calculate_loss(batch, training=True):

    images = batch["pixel_values"].to(
        DEVICE,
        dtype=WEIGHT_DTYPE,
        non_blocking=True
    )

    captions = batch["caption"]

    # Caption dropout.

    if training:

        captions = [
            "" if random.random() < CAPTION_DROPOUT
            else caption
            for caption in captions
        ]


    # --------------------------------------------------------
    # A. VAE IMAGE ENCODING (FROZEN)
    # --------------------------------------------------------

    with torch.no_grad():

        with torch.autocast(
            device_type="cuda",
            dtype=WEIGHT_DTYPE
        ):

            latents = vae.encode(
                images
            ).latent_dist.sample()

            latents = (
                latents * vae.config.scaling_factor
            )


    # --------------------------------------------------------
    # B. T5 TEXT ENCODING (FROZEN)
    # --------------------------------------------------------

    text_embeddings, attention_mask = encode_captions(
        captions
    )

    text_embeddings = text_embeddings.to(
        dtype=WEIGHT_DTYPE
    )


    # --------------------------------------------------------
    # C. RANDOM GAUSSIAN NOISE
    # --------------------------------------------------------

    noise = torch.randn_like(latents)

    batch_size = latents.shape[0]


    # --------------------------------------------------------
    # D. RANDOM TIMESTEPS
    # --------------------------------------------------------

    timesteps = torch.randint(
        0,
        noise_scheduler.config.num_train_timesteps,
        (batch_size,),
        device=DEVICE
    ).long()


    # --------------------------------------------------------
    # E. ADD NOISE TO LATENTS
    # --------------------------------------------------------

    noisy_latents = noise_scheduler.add_noise(
        latents,
        noise,
        timesteps
    )


    # --------------------------------------------------------
    # F. TARGET
    # --------------------------------------------------------

    prediction_type = (
        noise_scheduler.config.prediction_type
    )

    if prediction_type == "epsilon":

        target = noise

    elif prediction_type == "v_prediction":

        target = noise_scheduler.get_velocity(
            latents,
            noise,
            timesteps
        )

    else:

        raise ValueError(
            f"Unsupported prediction type: {prediction_type}"
        )


    # --------------------------------------------------------
    # G. PIXART FORWARD PASS
    # --------------------------------------------------------

    batch_size = images.shape[0]

    # PixArt additional micro-conditioning.

    resolution = torch.tensor(
        [[IMAGE_SIZE, IMAGE_SIZE]],
        device=DEVICE,
        dtype=WEIGHT_DTYPE
    ).repeat(batch_size, 1)

    aspect_ratio = torch.ones(
        (batch_size, 1),
        device=DEVICE,
        dtype=WEIGHT_DTYPE
    )

    added_cond_kwargs = {
        "resolution": resolution,
        "aspect_ratio": aspect_ratio
    }

    with torch.autocast(
        device_type="cuda",
        dtype=WEIGHT_DTYPE
    ):

        model_output = transformer(
            hidden_states=noisy_latents,
            timestep=timesteps,
            encoder_hidden_states=text_embeddings,
            encoder_attention_mask=attention_mask,
            added_cond_kwargs=added_cond_kwargs
        ).sample

        # PixArt can predict noise and variance together.

        if model_output.shape[1] == 2 * target.shape[1]:

            predicted_noise = model_output.chunk(
                2,
                dim=1
            )[0]

        else:

            predicted_noise = model_output


    # --------------------------------------------------------
    # H. MSE LOSS
    # --------------------------------------------------------

    loss = F.mse_loss(
        predicted_noise.float(),
        target.float(),
        reduction="mean"
    )

    return loss


# ============================================================
# 14. VALIDATION
# ============================================================

@torch.no_grad()

def validate():

    transformer.eval()

    total_loss = 0.0

    count = 0

    for batch in tqdm(
        validation_loader,
        desc="Validation"
    ):

        loss = calculate_loss(
            batch,
            training=False
        )

        total_loss += loss.item()

        count += 1

    transformer.train()

    return total_loss / max(count, 1)


# ============================================================
# 15. TRAINING
# ============================================================

history = {
    "train_loss": [],
    "validation_loss": []
}


for epoch in range(NUM_EPOCHS):

    transformer.train()

    optimizer.zero_grad(set_to_none=True)

    total_loss = 0.0

    progress = tqdm(
        enumerate(train_loader),
        total=len(train_loader),
        desc=f"Epoch {epoch + 1}/{NUM_EPOCHS}"
    )

    for step, batch in progress:

        loss = calculate_loss(
            batch,
            training=True
        )

        total_loss += loss.item()

        scaled_loss = loss / GRAD_ACCUMULATION

        scaler.scale(scaled_loss).backward()

        should_update = (
            (step + 1) % GRAD_ACCUMULATION == 0
            or (step + 1) == len(train_loader)
        )

        if should_update:

            scaler.unscale_(optimizer)

            torch.nn.utils.clip_grad_norm_(
                trainable_params,
                max_norm=1.0
            )

            scaler.step(optimizer)

            scaler.update()

            optimizer.zero_grad(set_to_none=True)

        progress.set_postfix(
            loss=f"{loss.item():.5f}"
        )

    train_loss = total_loss / max(
        len(train_loader),
        1
    )

    validation_loss = validate()

    history["train_loss"].append(train_loss)

    history["validation_loss"].append(validation_loss)

    print(f"\nEpoch: {epoch + 1}")

    print(f"Training Loss: {train_loss:.6f}")

    print(f"Validation Loss: {validation_loss:.6f}")


    # --------------------------------------------------------
    # SAVE AFTER EACH EPOCH
    # --------------------------------------------------------

    epoch_dir = os.path.join(
        OUTPUT_DIR,
        f"epoch_{epoch + 1}"
    )

    os.makedirs(
        epoch_dir,
        exist_ok=True
    )

    transformer.save_pretrained(
        epoch_dir,
        safe_serialization=True
    )

    print("Saved:", epoch_dir)


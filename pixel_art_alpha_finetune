).tolist()

num_val_images = max(
    1,
    int(len(unique_images) * VALIDATION_RATIO)
)

val_images = set(
    unique_images[i]
    for i in permutation[:num_val_images]
)

# All captions of an image remain in the same split.

train_df = full_dataset.df[
    ~full_dataset.df["image"].isin(val_images)
].reset_index(drop=True)

val_df = full_dataset.df[
    full_dataset.df["image"].isin(val_images)
].reset_index(drop=True)


# Create datasets with separate transformations.

train_dataset = FlickrImageDataset(

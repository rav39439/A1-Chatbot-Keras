def extract_links_from_html(html, base_url):

    soup = BeautifulSoup(
        html,
        "html.parser"
    )

    links = set()

    # ========================================================
    # GET ONLY THE MAIN WIKIPEDIA ARTICLE
    # ========================================================

    content = soup.select_one(
        "#mw-content-text .mw-parser-output"
    )

    if content is None:
        return links

    # ========================================================
    # REMOVE ELEMENTS THAT SHOULD NOT PROVIDE LINKS
    # ========================================================

    elements_to_remove = [
        "nav",
        "header",
        "footer",
        "aside",
        "script",
        "style",
        "noscript",
        "form",
        "figure",
        ".navbox",
        ".vertical-navbox",
        ".sidebar",
        ".mw-portlet",
        ".metadata",
        ".ambox",
        ".hatnote",
        ".infobox",
        ".reflist",
        ".reference",
        ".references",
        "#toc",
        ".toc",
    ]

    for selector in elements_to_remove:

        for element in content.select(
            selector
        ):

            element.decompose()

    # ========================================================
    # EXTRACT LINKS ONLY FROM REMAINING ARTICLE CONTENT
    # ========================================================

    for a in content.find_all(
        "a",
        href=True
    ):

        href = a["href"].strip()

        if not href:
            continue

        # Ignore anchors
        if href.startswith("#"):
            continue

        # Ignore non-web links
        if href.startswith(
            (
                "mailto:",
                "javascript:",
                "tel:"
            )
        ):
            continue

        # Convert relative URL to absolute
        full_url = urljoin(
            base_url,
            href
        )

        # Remove #section
        full_url, _ = urldefrag(
            full_url
        )

        parsed = urlparse(
            full_url
        )

        # ====================================================
        # ONLY WIKIPEDIA
        # ====================================================

        if parsed.netloc != "en.wikipedia.org":
            continue

        # ====================================================
        # ONLY WIKI ARTICLE URLS
        # ====================================================

        if not parsed.path.startswith(
            "/wiki/"
        ):
            continue

        article_name = parsed.path[
            len("/wiki/"):
        ]

        if not article_name:
            continue

        # ====================================================
        # REMOVE NON-ARTICLE NAMESPACES
        # ====================================================

        blocked_prefixes = (
            "Special:",
            "File:",
            "Template:",
            "Category:",
            "Help:",
            "Portal:",
            "Wikipedia:",
            "Talk:",
            "User:",
            "User_talk:",
            "Draft:",
            "Module:",
            "Book:",
            "MediaWiki:",
        )

        if article_name.startswith(
            blocked_prefixes
        ):
            continue

        # ====================================================
        # ADD LINK
        # ====================================================

        links.add(
            full_url
        )

    return links


# ============================================================
# SCRAPE ONE PAGE
# ============================================================

def scrape_page(
    page,
    url,
    depth,
    visited,
    max_links,
    max_depth,
    output_file
):

    # ========================================================
    # STOP CONDITIONS
    # ========================================================

    if len(visited) >= max_links:
        return

    if depth > max_depth:
        return

    if url in visited:
        return

    # ========================================================
    # MARK URL AS VISITED
    # ========================================================

    visited.add(url)

    page_number = len(visited)

    print()
    print("=" * 90)

    print(
        f"SCRAPING PAGE {page_number}/{max_links}"
    )

    print(
        f"DEPTH : {depth}"
    )

    print(
        f"URL   : {url}"
    )

    print("=" * 90)

    # ========================================================
    # STEP 1 -> LOAD PAGE
    # ========================================================

    try:

        page.goto(
            url,
            wait_until="networkidle",
            timeout=120000
        )

    except Exception as e:

        print(
            f"FAILED TO LOAD PAGE: {e}"
        )

        return

    # ========================================================
    # STEP 2 -> GET HTML
    # ========================================================

    try:

        html = page.content()

    except Exception as e:

        print(
            f"FAILED TO GET HTML: {e}"
        )

        return

    # ========================================================
    # STEP 3 -> SCRAPE PAGE
    # ========================================================

    try:

        root = html_to_xml(
            html
        )

    except Exception as e:

        print(
            f"FAILED TO PARSE PAGE: {e}"
        )

        return

    # ========================================================
    # STEP 4 -> COUNT DATA
    # ========================================================

    headings = root.findall(
        ".//heading"
    )

    paragraphs = root.findall(
        ".//paragraph"
    )

    lists = root.findall(
        ".//list"
    )

    items = root.findall(
        ".//item"
    )

    print(
        f"Headings   : {len(headings)}"
    )

    print(
        f"Paragraphs : {len(paragraphs)}"
    )

    print(
        f"Lists      : {len(lists)}"
    )

    print(
        f"List items : {len(items)}"
    )

    # ========================================================
    # STEP 5 -> WRITE CURRENT PAGE
    # ========================================================

    try:

        # write_page_data(
        #     page_root=root,
        #     output_file=output_file,
        #     url=url,
        #     page_number=page_number
        # )

        print(
            f"Page {page_number} written successfully"
        )

        print(
            f"Output     : {output_file}"
        )

    except Exception as e:

        print(
            f"FAILED TO WRITE PAGE: {e}"
        )

        return

    # ========================================================
    # STEP 6 -> STOP AFTER LAST PAGE
    # ========================================================

    if len(visited) >= max_links:

        print()
        print(
            f"PAGE {page_number} WAS THE LAST PAGE"
        )

        print(
            "Maximum page limit reached."
        )

        return

    # ========================================================
    # STEP 7 -> STOP AT MAX DEPTH
    # ========================================================

    if depth >= max_depth:

        print(
            "Maximum depth reached."
        )

        return

    # ========================================================
    # STEP 8 -> EXTRACT LINKS
    # ========================================================

    links = extract_links_from_html(
        html,
        url
    )

    print(
        f"Links found: {len(links)}"
    )

    # ========================================================
    # STEP 9 -> GO TO NEXT PAGE
    # ========================================================

    for link in links:

        if len(visited) >= max_links:
            return

        if link in visited:
            continue

        print()
        print(
            f"NEXT PAGE -> {link}"
        )

        scrape_page(
            page=page,
            url=link,
            depth=depth + 1,
            visited=visited,
            max_links=max_links,
            max_depth=max_depth,
            output_file=output_file
        )

        if len(visited) >= max_links:
            return


# ============================================================
# MAIN SCRAPER FUNCTION
# ============================================================

def scrape_websites(
    input_link: str,
    output_path: str,
    number_of_links: int,
    max_depth: int = 3,
    scraped_links=None
):

    if scraped_links is None:
        scraped_links = set()

    # Use previously scraped links as visited URLs
    visited = scraped_links

    if not input_link:
        raise ValueError(
            "input_link cannot be empty."
        )

    if number_of_links <= 0:
        raise ValueError(
            "number_of_links must be greater than 0."
        )

    if max_depth < 0:
        raise ValueError(
            "max_depth cannot be negative."
        )

    # ========================================================
    # CREATE OUTPUT DIRECTORY
    # ========================================================

    output_directory = os.path.dirname(
        output_path
    )

    if output_directory:

        os.makedirs(
            output_directory,
            exist_ok=True
        )

    # ========================================================
    # VISITED URLS
    # ========================================================

    # DO NOT create a new set here.
    # We must keep the previously scraped URLs.

    print()
    print("=" * 90)

    print(
        "STARTING WEB SCRAPER"
    )

    print(
        f"Starting URL : {input_link}"
    )

    print(
        f"Output file  : {output_path}"
    )

    print(
        f"Max pages    : {number_of_links}"
    )

    print(
        f"Max depth    : {max_depth}"
    )

    print(
        f"Already scraped : {len(visited)}"
    )

    print("=" * 90)

    # ========================================================
    # START PLAYWRIGHT
    # ========================================================

    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=True
        )

        page = browser.new_page()

        scrape_page(
            page=page,
            url=input_link,
            depth=0,
            visited=visited,
            max_links=number_of_links,
            max_depth=max_depth,
            output_file=output_path
        )

        browser.close()

    # ========================================================
    # FINAL RESULT
    # ========================================================

    print()
    print("=" * 90)

    print(
        "SCRAPING COMPLETE"
    )

    print(
        f"Total scraped pages : {len(visited)}"
    )

    print(
        f"Output file         : {output_path}"
    )

    print("=" * 90)

    return visited


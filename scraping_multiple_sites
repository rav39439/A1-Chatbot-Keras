# ============================================================
# LOAD SCRAPED LINKS
# ============================================================

def load_scraped_links(
    links_file: str
):
    """
    Load previously scraped links from file.
    """

    if not os.path.exists(
        links_file
    ):
        return set()

    with open(
        links_file,
        "r",
        encoding="utf-8"
    ) as f:

        return {
            line.strip()
            for line in f
            if line.strip()
        }


# ============================================================
# SAVE SCRAPED LINKS
# ============================================================

def save_scraped_links(
    links_file: str,
    scraped_links
):
    """
    Save all scraped links to file.
    """

    output_directory = os.path.dirname(
        links_file
    )

    if output_directory:

        os.makedirs(
            output_directory,
            exist_ok=True
        )

    with open(
        links_file,
        "w",
        encoding="utf-8"
    ) as f:

        for link in sorted(
            scraped_links
        ):

            f.write(
                link + "\n"
            )



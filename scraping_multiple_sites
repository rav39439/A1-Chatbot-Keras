            print(
                f"Failed to scrape: {input_link}"
            )

            print(
                f"Error: {e}"
            )

            continue

        # ----------------------------------------------------
        # ADD THE SUCCESSFULLY SCRAPED URL
        # ----------------------------------------------------

        scraped_links.add(
            input_link
        )

        # ----------------------------------------------------
        # SAVE UPDATED SCRAPED LINKS
        # ----------------------------------------------------

        save_scraped_links(
            scraped_links_path,
            scraped_links
        )

        # ----------------------------------------------------
        # CONVERT XML TO CLEAN TEXT
        # ----------------------------------------------------

        xml_to_clean_text(
            input_xml=xml_output_path,
            output_txt=clean_output_path
        )

        print(
            f"Completed: {input_link}"
        )

    # ========================================================
    # FINAL RESULT
    # ========================================================

    print()
    print("=" * 90)

    print(
        "PHYSICS CORPUS CREATION COMPLETE"
    )

    print(
        f"Total scraped links : {len(scraped_links)}"
    )

    print(
        f"XML file            : {xml_output_path}"
    )

    print(
        f"Text corpus         : {clean_output_path}"
    )

    print(
        f"Links file          : {scraped_links_path}"
    )

    print("=" * 90)



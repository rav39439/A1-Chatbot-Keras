# ============================================================
# XML -> CLEAN TEXT
# ============================================================
# ============================================================

def xml_to_clean_text(
    input_xml: str,
    output_txt: str
):
    """
    Read the XML generated by the scraper and convert it into
    clean text without headings.

    The generated text is APPENDED to the existing TXT file.

    A blank line is added only when moving from one section
    to the next section.

    Output format:

    Paragraph one... Paragraph two...
    • List item one
    • List item two

    Paragraph from next section...
    • Another list item
    """

    # --------------------------------------------------------
    # Validate input file
    # --------------------------------------------------------

    if not os.path.exists(input_xml):
        raise FileNotFoundError(
            f"XML file not found: {input_xml}"
        )

    # --------------------------------------------------------
    # Parse XML
    # --------------------------------------------------------

    try:
        tree = ET.parse(
            input_xml
        )

        root = tree.getroot()

    except ET.ParseError as e:
        raise ValueError(
            f"Invalid XML file: {e}"
        )

    # --------------------------------------------------------
    # Store complete sections
    # --------------------------------------------------------

    sections_output = []

    # --------------------------------------------------------
    # Process each page
    # --------------------------------------------------------

    for page in root.findall("page"):

        # ----------------------------------------------------
        # Process each section
        # ----------------------------------------------------

        for section in page.findall("section"):

            section_lines = []

            # ------------------------------------------------
            # Collect paragraphs
            # ------------------------------------------------

            paragraphs = []

            for paragraph in section.findall(
                "paragraph"
            ):

                text = (
                    paragraph.text or ""
                ).strip()

                text = re.sub(
                    r"\s+",
                    " ",
                    text
                ).strip()

                if text:
                    paragraphs.append(
                        text
                    )

            # ------------------------------------------------
            # Merge all paragraphs into one block
            # ------------------------------------------------

            if paragraphs:

                merged_paragraphs = " ".join(
                    paragraphs
                )

                section_lines.append(
                    merged_paragraphs
                )

            # ------------------------------------------------
            # Collect list items
            # ------------------------------------------------

            list_items = []

            for list_element in section.findall(
                "list"
            ):

                for item in list_element.findall(
                    "item"
                ):

                    text = (
                        item.text or ""
                    ).strip()

                    text = re.sub(
                        r"\s+",
                        " ",
                        text
                    ).strip()

                    if text:
                        list_items.append(
                            text
                        )

            # ------------------------------------------------
            # Add list items immediately after paragraphs
            # ------------------------------------------------

            for item in list_items:

                section_lines.append(
                    f"• {item}"
                )

            # ------------------------------------------------
            # Skip completely empty sections
            # ------------------------------------------------

            if not section_lines:
                continue

            # ------------------------------------------------
            # Store this complete section
            # ------------------------------------------------

            sections_output.append(
                "\n".join(section_lines)
            )

    # --------------------------------------------------------
    # Join sections
    #
    # Exactly ONE blank line is added between sections.
    # No extra blank lines are added inside a section.
    # --------------------------------------------------------

    final_text = "\n\n".join(
        sections_output
    ).strip()

    # --------------------------------------------------------
    # Create output directory
    # --------------------------------------------------------

    output_directory = os.path.dirname(
        output_txt
    )

    if output_directory:

        os.makedirs(
            output_directory,
            exist_ok=True
        )

    # --------------------------------------------------------
    # Append text to existing TXT file
    # --------------------------------------------------------

    with open(
        output_txt,
        "a",
        encoding="utf-8"
    ) as f:

        # ----------------------------------------------------
        # Add separation before new content if file exists
        # ----------------------------------------------------

        if (
            os.path.exists(output_txt)
            and os.path.getsize(output_txt) > 0
        ):

            f.write(
                "\n\n"
            )

        f.write(
            final_text
        )

    # --------------------------------------------------------
    # Print output information
    # --------------------------------------------------------

    print()

    print("=" * 90)

    print(
        "XML -> CLEAN TEXT APPEND COMPLETE"
    )

    print("=" * 90)

    print(
        f"Input XML  : {input_xml}"
    )

    print(
        f"Output TXT : {output_txt}"
    )

    print("=" * 90)

    print()

    print(
        final_text
    )

    return final_text
